{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "label": "Build + Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: configure with source",
                "CMake: clean rebuild",
                "CubeProg: Flash project (SWD)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: configure with source",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build/debug",
                "-DMAIN_SOURCE=${input:mainSourceFile}"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: clean rebuild",
            "type": "cmake",
            "command": "cleanRebuild",
            "targets": ["all"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template clean rebuild task"
        },
        {
            "label": "CubeProg: Flash project (SWD)",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "--connect", "port=swd",
                "--download", "${command:cmake.launchTargetPath}",
                "-hardRst",
                "-rst",
                "--start"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CubeProg: List all available communication interfaces",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": ["--list"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "mainSourceFile",
            "type": "pickString",
            "description": "Select source file to compile",
            "options": [
                "spi_send_main.c",
                "spi_send_and_receive_main.c",
                "spi_commands_main.c",
                "spi_interrupts_main.c",
                "i2c_main.c"
            ],
            "default": "spi_send_main.c"
        }
    ]
}